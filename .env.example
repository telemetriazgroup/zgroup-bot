# === Base de datos ===
DB_HOST=db
DB_PORT=5432
DB_NAME=zgroup
DB_USER=zgroupuser
DB_PASSWORD=cambia_esta_password_segura

# === API del bot ===
PORT=9301
API_SECRET=token_secreto_para_llamadas_internas

# === WhatsApp ===
BOT_NOMBRE=ZGroup Bot
BOT_PREFIJO=!

# === Alertas ===
ALERTA_TEMP_MAX=-10      # °C — por encima de esto es alerta
ALERTA_TEMP_MIN=-30      # °C — por debajo de esto es alerta crítica

# === Outbox WhatsApp (anti-spam) ===
# Alertas push: 1 destinatario por minuto
OUTBOX_GAP_ALERTA_MS=60000
# Conversación activa (usuario escribió): máx. entre mensajes
OUTBOX_GAP_ACTIVO_MS=10000
# Ventana "chat activo" tras un inbound
OUTBOX_ACTIVO_MS=900000

# Aviso a números no activados (contactar para habilitar chat)
AVISO_NO_ACTIVO_MS=90000
CONTACTO_ACTIVACION_NOMBRE=Luis Marcelo
CONTACTO_ACTIVACION_TEL=908947464
